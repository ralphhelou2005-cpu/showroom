+  // The official logo (assets/logo/logo-white.png) replaces the text on the facade sign once it loads.
+  loadLogo() {
+    const image = new Image();
+    image.onload = () => { this.logoImage = image; this.applyLogo(); };
+    image.src = 'assets/logo/logo-white.png';
+  }
+
+  applyLogo() {
+    const image = this.logoImage;
+    if (!image || !this.logoPlates) return;
+    for (const plate of this.logoPlates) {
+      const { canvas, texture, aspect } = plate;
+      canvas.width = 3072;
+      canvas.height = Math.round(3072 / aspect);
+      const g = canvas.getContext('2d');
+      const { width: w, height: h } = canvas;
+      const bg = g.createLinearGradient(0, 0, 0, h);
+      bg.addColorStop(0, '#2a2e30');
+      bg.addColorStop(0.5, '#171a1c');
+      bg.addColorStop(1, '#25292b');
+      g.fillStyle = bg;
+      g.fillRect(0, 0, w, h);
+      const scale = Math.min((w * 0.72) / image.width, (h * 0.66) / image.height);
+      const dw = image.width * scale;
+      const dh = image.height * scale;
+      g.drawImage(image, (w - dw) / 2, (h - dh) / 2, dw, dh);
+      texture.dispose();
+      texture.needsUpdate = true;
+    }
+    this.requestRender();
+  }
+
+  // k = 0 daylight, 0.5 golden hour, 1 evening. Driven by the scroll story; call it yourself for a fixed mood.
+  setTimeOfDay(k) {
