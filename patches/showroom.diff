+    const tmp = (this._eveningTmp ??= new THREE.Color());
+    const colour = (key) => {
+      const [a, b, c] = cache[key];
+      return k < 0.5 ? tmp.copy(a).lerp(b, k * 2) : tmp.copy(b).lerp(c, (k - 0.5) * 2);
+    };
+    const number = ([a, b, c]) => (k < 0.5 ? a + (b - a) * k * 2 : b + (c - b) * (k - 0.5) * 2);
+
